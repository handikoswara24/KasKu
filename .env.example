# GEMINI_API_KEY: Required for Gemini AI receipt scanning API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, add this in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: Connection string for MongoDB Atlas or self-hosted MongoDB.
# Example: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=""

# MONGODB_DB_NAME: Optional database name (defaults to kasku_finance).
MONGODB_DB_NAME="kasku_finance"

# IMAGEKIT_PRIVATE_KEY: Private API key from ImageKit Dashboard (Developer Options -> API Keys).
# Used on the server to upload receipt images to ImageKit instead of storing them in MongoDB.
IMAGEKIT_PRIVATE_KEY=""

# IMAGEKIT_FOLDER: Optional ImageKit target folder for uploaded receipt images.
IMAGEKIT_FOLDER="/kasku-notas"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"
